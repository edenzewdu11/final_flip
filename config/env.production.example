# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
# IMPORTANT: include the server's public IP and any domain you serve from.
# Example for Ethio Telecom server: 196.189.236.140,your-domain.com,localhost
ALLOWED_HOSTS=flipstar.et,www.flipstar.et,196.189.236.140,localhost,127.0.0.1


# Database Configuration
# Force use of the local Docker postgres service. Leave this TRUE for the
# Ethio Telecom server so stray RENDER / DATABASE_URL env vars can't silently
# redirect the app to an old Neon database.
USE_DOCKER_DB=true
DB_NAME=flipstar_db
DB_USER=flipstar_user
DB_PASSWORD=your-db-password-here
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Storage - Ethiotelecom Object Storage
ACCESS_KEY_ID=your_ethiotelecom_access_key
SECRET_ACCESS_KEY=your_ethiotelecom_secret_key
STORAGE_BUCKET_NAME=flipstar-media
REGION_NAME=et-global-3
S3_ENDPOINT_URL=http://flipstar.obsv3.et-global-3.ethiotelecom.et

# CORS Settings
CORS_ALLOWED_ORIGINS=https://flipstar.et,https://www.flipstar.et,http://localhost

# Cloudinary (optional - will be removed after S3 migration)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Telebirr H5 / SuperApp Web Checkout (Fabric Payment Gateway) ────────────
# Test bed gateway (default). For production switch to:
#   https://telebirrappcube.ethiomobilemoney.et:38443/apiaccess/payment/gateway
TELEBIRR_H5_BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
# Fabric portal credentials (X-APP-Key + appSecret)
TELEBIRR_FABRIC_APP_ID=your-fabric-x-app-key
TELEBIRR_APP_SECRET=your-fabric-app-secret
# Merchant identity assigned by the Mobile Payment system
TELEBIRR_MERCHANT_APP_ID=your-merchant-appid
TELEBIRR_MERCHANT_CODE=your-merchant-short-code
# RSA keys (PEM). Use literal \n for newlines on a single line, or a real
# multi-line value. TELEBIRR_PRIVATE_KEY signs our requests; TELEBIRR_PUBLIC_KEY
# is the Telebirr/SP public key used to verify async notifications.
TELEBIRR_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
TELEBIRR_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# Async notify + post-payment redirect (must be publicly reachable / whitelisted)
TELEBIRR_NOTIFY_URL=https://flipstar.et/api/wallet/telebirr-callback/
TELEBIRR_REDIRECT_URL=https://flipstar.et/wallet
# Set true once the gateway TLS chain is trusted; testbed often needs false.
TELEBIRR_VERIFY_SSL=false

# ─── Telebirr Direct Debit (SOAP API) ────────────────────────────────────────
# SOAP endpoint for direct debit mandate creation and transactions
TELEBIRR_SOAP_URL=https://10.180.70.177:30002/payment/services/APIRequestMgrService
# Third-party credentials for SOAP API
TELEBIRR_THIRD_PARTY_ID=SKYKIN
TELEBIRR_THIRD_PARTY_PASSWORD=your-third-party-password
# SP Operator credentials for SOAP API
TELEBIRR_SP_OPERATOR_ID=SKY8721
TELEBIRR_SP_OPERATOR_CREDENTIAL=your-sp-operator-credential
# Organization Operator credentials for SOAP API
TELEBIRR_ORG_OPERATOR_ID=EXTSYSSKYKIN
TELEBIRR_ORG_OPERATOR_CREDENTIAL=lUhB2GFynauq6KX6uq9TyVOfcD4tONdL4ElNELO0JKQ=
# Payee shortcode and account name
TELEBIRR_SHORTCODE=53599
TELEBIRR_PAYEE_ACCOUNT_NAME=Flipstar
# Webhook URL for Telebirr async result callbacks (must be publicly accessible)
TELEBIRR_RESULT_URL=http://uat.flipstar.et:6082/api/webhooks/telebirrDirectDebit/

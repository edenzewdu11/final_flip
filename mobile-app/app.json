{
  "expo": {
    "name": "FlipStar",
    "slug": "flipstar-mobile",
    "version": "1.0.0",
    "icon": "./assets/icon-valid.png",
    "newArchEnabled": false,
    "plugins": [
      "expo-secure-store",
      "expo-video",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash.png",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-iap"
    ],
    "android": {
      "package": "com.skykintech.flipstar",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "pan",
      "orientation": "default",
      "userInterfaceStyle": "automatic",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "bundleIdentifier": "com.skykintech.flipstar",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "FlipStar needs access to your photo library so you can select a video or photo from your device to upload as a Flip and enter it into a competition.",
        "NSCameraUsageDescription": "FlipStar needs access to your camera so you can capture a video or photo to upload as a Flip and enter it into a competition.",
        "NSMicrophoneUsageDescription": "FlipStar needs access to your microphone to record audio with your video Flips."
      }
    },
    "extra": {
      "publicUrls": {
        "website": "https://flipstar.et",
        "privacyPolicy": "https://flipstar.et/privacy-policy",
        "deleteAccount": "https://flipstar.et/delete-account"
      },
      "eas": {
        "projectId": "83bf6e4f-df2b-41c5-809d-2c8004cacf1a"
      }
    },
    "owner": "ashineeshetu"
  }
}
